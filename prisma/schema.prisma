generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Member {
  id               String    @id @default(uuid())
  publicToken      String    @unique
  memberName       String
  companyName      String?
  businessCategory String?
  phone            String?
  address          String?
  birthday         DateTime? @db.Date
  anniversary      DateTime? @db.Date
  website          String?
  instagram        String?
  email            String?
  facebook         String?
  youtube          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Trigram indexes serve the case-insensitive "contains" search; B-tree ones serve sorting.
  @@index([memberName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Member_memberName_trgm_idx")
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Member_companyName_trgm_idx")
  @@index([businessCategory(ops: raw("gin_trgm_ops"))], type: Gin, map: "Member_businessCategory_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Member_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Member_phone_trgm_idx")
  @@index([memberName])
  @@index([createdAt])
}

// Fixed-window request counters (see rateLimit in lib/security.ts).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)
}
