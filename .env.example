# Copy to .env and fill in. Never commit .env.

# PostgreSQL used by the app. In production this may be a pooled URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bnitrendz"
# Optional: direct (non-pooled) URL used only by migrations, e.g. Neon's DATABASE_URL_UNPOOLED.
DIRECT_URL=""
# Separate database for `npm test`. It is wiped before every test, so never point it at real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bnitrendz_test"

# NextAuth session signing/encryption secret. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Base URL of the app for NextAuth (not needed on Vercel).
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used in member profile links and QR codes (no trailing slash).
# Optional on Vercel: it defaults to the project's production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IANA timezone for the dashboard's "today"/"this month" counts and CRM dates, e.g. Asia/Karachi.
APP_TIMEZONE="UTC"

# WhatsApp Cloud API (Meta) for messaging members from the CRM. Leave empty to disable.
# Use a permanent System User token with whatsapp_business_messaging + whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Initial admin created or updated by `npx prisma db seed`. Use a strong, unique password.
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
